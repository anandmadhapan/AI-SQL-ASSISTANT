# =====================================
# Application Environment
# =====================================
ASCEND_ENV=dev

# =====================================
# PostgreSQL Database (Supabase or any PG)
# =====================================
DB_HOST=your-db-host.supabase.co
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=your-db-password

# =====================================
# Google AI — Gemini via ADK
# Get a key at: https://aistudio.google.com/app/apikey
# =====================================
GOOGLE_API_KEY=your-google-api-key-here

# =====================================
# Security
# =====================================
SECRET_KEY=change-this-to-a-random-secret-in-production

# Optional: SELECT-only role for AI-generated SQL (see docs/readonly_role.sql)
# READONLY_DATABASE_URL=postgresql+psycopg2://ai_readonly:password@localhost:5432/postgres
# AI_SQL_TIMEOUT_MS=10000
